/*
Exercise 3: Advanced Features
Build a library management system with:
• Book inventory
• Student borrowing records
• Fine calculation
• Search functionality with multiple filters
*/

use mysql_jdbc_practice;

--------------------------------------------------
-- 1. Book Inventory
--------------------------------------------------

CREATE TABLE books (
    book_id INT PRIMARY KEY,
    title VARCHAR(100),
    author VARCHAR(50),
    category VARCHAR(50),
    total_copies INT,
    available_copies INT
);

INSERT INTO books VALUES
(1, 'Java Basics', 'James Gosling', 'Programming', 5, 3),
(2, 'DBMS Concepts', 'Korth', 'Database', 4, 2),
(3, 'Python Guide', 'Guido', 'Programming', 6, 6);

SELECT * FROM books;

--------------------------------------------------
-- 2. Student Borrowing Records
--------------------------------------------------

CREATE TABLE students (
    student_id INT PRIMARY KEY,
    name VARCHAR(50)
);



CREATE TABLE borrow_records (
    borrow_id INT PRIMARY KEY,
    student_id INT,
    book_id INT,
    borrow_date DATE,
    return_date DATE
);


INSERT INTO students VALUES
(1, 'Ankit'),
(2, 'Ravi');




INSERT INTO borrow_records VALUES
(101, 1, 1, '2026-01-01', NULL),
(102, 2, 2, '2026-01-05', '2026-01-12');
SELECT * FROM students;
SELECT * FROM borrow_records;

--------------------------------------------------
-- 3. Fine Calculation
--------------------------------------------------

SELECT 
    borrow_id,
    student_id,
    book_id,
    DATEDIFF(CURDATE(), borrow_date) - 7 AS late_days,
    (DATEDIFF(CURDATE(), borrow_date) - 7) * 5 AS fine_amount
FROM borrow_records
WHERE return_date IS NULL
AND DATEDIFF(CURDATE(), borrow_date) > 7;

--------------------------------------------------
-- 4. Search Functionality with Multiple Filters
--------------------------------------------------

-- Example 1: Search by author and category

SELECT * 
FROM books
WHERE author = 'James Gosling'
AND category = 'Programming';

-- Example 2: Search books with available copies

SELECT * 
FROM books
WHERE available_copies > 0;

-- Example 3: Search by title keyword
SELECT * 
FROM books
WHERE title LIKE '%Java%';
 